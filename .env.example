# 环境变量模板：复制为 .env（开发）或 .env.production（生产）后修改
# 网关（SSO）就绪后，把四项改成同源相对路径即可，无需改代码：
#   /api/data  /api/v09/data  /api/v1  /api/v2/financial

# 业务报表通用查询（dev 走 Vite proxy → horgrix.com）
VITE_API_BASE_URL=/api/data
# v09 数据服务（dev 走 Vite proxy → api.horgrix.com）
VITE_V09_API_BASE_URL=/api/v09/data
# 量化接口
VITE_QUANT_API_BASE_URL=/api/v1
# 财务接口
VITE_FINANCIAL_API_BASE_URL=/api/v2/financial

# 访问统计 PV/UV 接口
VITE_STATS_BASE_URL=/api/stats
# 数据大盘静态 JSON 目录（默认 /_api/dashboard，dev 由 vite proxy 转发到 horgrix.com）
# VITE_DASHBOARD_BASE_URL=/_api/dashboard
# 未就绪时用 mock 数据自测（true/false，生产不要开）
# VITE_STATS_MOCK=true
# 网关鉴权：off（默认）| sso（走 nginx auth_request + oauth2-proxy）
VITE_AUTH_MODE=off
